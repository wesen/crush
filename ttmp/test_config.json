        "enabled": true
      },
      "magic_message": {
        "enabled": true,
        "config": {
          "magic_words": ["ALAKAZAM", "PRESTO", "ABRACADABRA"]
        }
      }
    }
  },
  "debug": {
    "enabled": true,
    "log_level": "info"
  }
}
