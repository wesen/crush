{
  "hooks": {
    "enabled": true,
    "plugins": [
      {
        "path": "ttmp/test_plugin.so",
        "enabled": true
      }
    ],
    "circuit_breaker": {
      "failure_threshold": 3,
      "timeout_ms": 5000,
      "recovery_timeout_ms": 30000
    },
    "builtin": {
